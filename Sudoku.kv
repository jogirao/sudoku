#:import menu menu

MainWidget:

<MainWidget>:
    MainBoxLayout

<MainBoxLayout>:
    orientation: "vertical"
    spacing: "10dp"
    padding: "10dp"
    canvas.before:
        Color:
            rgba: (.95, .95, .95, 1)
        Rectangle:
            size: self.size
            pos: self.pos
    UpperBoxLayout:
        size_hint: 1, None
        height: "60dp"
    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1
        spacing: "10dp"
        SudokuGridLayout:
            size_hint: 1, 0.6
        NumPadLayout:
            size_hint: 1, 0.4

<UpperBoxLayout>:
    orientation: "horizontal"
    size_hint: 1, None
    height: "60dp"
    padding: "5dp"
    canvas.before:
        Color:
            rgba: (.5, .8, 1, 1)
        Rectangle:
            size: self.size
            pos: self.pos
    Button:
        text: "≡"
        font_size: "30sp"
        background_color: (1, 1, 1, .25) if self.state == "normal" else (1, 1, 1, .15)
        size_hint: None, 1
        width: "60dp"
        on_press: root.parent.parent.manager.current = "menu"
    Label:
        text: "Sudoku Puzzle"
        font_size: "20sp"
        bold: True
        color: (1, 1, 1, 1)
        size_hint: 1, 1

<Cell>:
    background_color: 0, 0, 0, 0
    background_normal: ""
    bold: "True"
    group: "Cells"
    font_size: self.size[0] * .8
    canvas.before:
        Color:
            rgba: (1, 1, 1, 1) if self.state == "normal" else (.5, .8, 1, 1)
        Rectangle:
            size: self.size
            pos: self.pos

<NumPadButton>:
    background_color: 0, 0, 0, 0
    background_normal: ''
    bold: True
    font_size: min(self.width, self.height) * 0.5
    color: (0.3, 0.3, 0.3, 1)
    canvas.before:
        Color:
            rgba: (1, 1, 1, 1) if self.state == "normal" else (.5, .8, 1, 1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [8]
        Color:
            rgba: (0.85, 0.85, 0.85, 1) if self.state == "normal" else (.4, .7, .95, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
            width: 1.5

<NumPadControlButton>:
    background_color: 0, 0, 0, 0
    background_normal: ''
    bold: True
    font_size: "18sp"
    color: (1, 1, 1, 1)
    canvas.before:
        Color:
            rgba: (0.9, 0.4, 0.4, 1) if self.state == "normal" else (0.95, 0.5, 0.5, 1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [8]

<NumPadLayout>:
    orientation: "vertical"
    spacing: "8dp"
    padding: "10dp"
    canvas.before:
        Color:
            rgba: (.95, .95, .95, 1)
        Rectangle:
            size: self.size
            pos: self.pos
    GridLayout:
        id: numbers_grid
        cols: 3
        rows: 3
        spacing: "6dp"
        size_hint: 1, 1
        padding: 0
        NumPadButton:
            text: "1"
        NumPadButton:
            text: "2"
        NumPadButton:
            text: "3"
        NumPadButton:
            text: "4"
        NumPadButton:
            text: "5"
        NumPadButton:
            text: "6"
        NumPadButton:
            text: "7"
        NumPadButton:
            text: "8"
        NumPadButton:
            text: "9"
    BoxLayout:
        orientation: "horizontal"
        spacing: "8dp"
        size_hint: 1, None
        height: "50dp"
        NumPadControlButton:
            text: "Delete"
        NumPadControlButton:
            text: "Clear"

<SudokuBox>:
    rows: 3
    spacing: "2dp"
    canvas.before:
        Color:
            rgba: (0.7, 0.7, 0.7, 1)
        Rectangle:
            size: self.size
            pos: self.pos

<SudokuGrid>:
    rows: 3
    padding: "4dp"
    spacing: "4dp"
    canvas.before:
        Color:
            rgba: (0, 0, 0, 1)
        Rectangle:
            size: self.size
            pos: self.pos

<SudokuGridLayout>:
    padding: "10dp"
    canvas.before:
        Color:
            rgba: (.95, .95, .95, 1)
        Rectangle:
            size: self.size
            pos: self.pos
    BoxLayout:
        size_hint: None, None
        size: min(root.width - 20, root.height - 20), min(root.width - 20, root.height - 20)
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        SudokuGrid:
            size_hint: 1, 1