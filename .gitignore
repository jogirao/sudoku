*.manifest
*.spec

# Installer/packaging metadata
*.egg-info/
.installed.cfg

# PyCharm/IDE
.idea/
*.iml
.vscode/
*.code-workspace

# Editor temporary files
*~
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints

# MyPy
.mypy_cache/

# Coverage reports
coverage.xml

# Local environment variables
.env
.env.*

# Logs
logs/
*.log

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Node / frontend (if any)
node_modules/

# Misc
*.bak
*.tmp

# Keep images, assets, puzzles and solutions tracked (explicitly allow)
!images/
!Puzzles.txt
!Solutions.txt
!Test_Sudoku.txt

# If you ever add a venv inside other folders, ignore them as well
**/venv/
**/.venv/
