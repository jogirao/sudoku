
<PuzzleLibraryWidget>:
    canvas.before:
        Color:
            rgba: (1, 1, 1, 1)
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0

        # Header bar
        BoxLayout:
            size_hint_y: None
            height: "64dp"
            orientation: "horizontal"
            spacing: "12dp"
            padding: "12dp", "8dp", "12dp", "8dp"
            canvas.before:
                Color:
                    rgba: (.45, .75, 1, 1)
                Rectangle:
                    size: self.size
                    pos: self.pos
                # Subtle shadow effect
                Color:
                    rgba: (0, 0, 0, 0.1)
                Rectangle:
                    pos: self.x, self.y - 2
                    size: self.width, 2

            Button:
                text: "←"
                font_size: "24sp"
                background_color: 0, 0, 0, 0
                size_hint: None, 1
                width: "48dp"
                on_press: root.manager.current = "menu"
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 0.15) if self.state == "normal" else (1, 1, 1, 0.25)
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [8]

            Label:
                text: "Puzzle Library"
                font_size: "22sp"
                bold: True
                color: (1, 1, 1, 1)
                size_hint: 1, 1
                halign: "left"
                valign: "center"
                text_size: self.size
                padding: "8dp", "0dp"

        # Gallery area
        ScrollView:
            id: scroll_view
            do_scroll_x: False
            do_scroll_y: True

            GridLayout:
                id: gallery_grid
                cols: 1
                spacing: "16dp"
                padding: "24dp"
                size_hint_y: None
                height: self.minimum_height

                # Dynamically populated with puzzle cards
