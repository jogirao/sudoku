MainWidget:

<MainWidget>:
    MainBoxLayout

<MainBoxLayout>:
    orientation: "vertical"
    spacing: 0
    padding: 0
    canvas.before:
        Color:
            rgba: (.95, .95, .95, 1)
        Rectangle:
            size: self.size
            pos: self.pos
    UpperBoxLayout:
        size_hint_y: None
        height: "64dp"
    BoxLayout:
        orientation: "vertical"
        spacing: "8dp"
        padding: "10dp", "10dp", "10dp", "10dp"
        SudokuGridLayout:
            size_hint: 1, 0.6
        NumPadLayout:
            size_hint: 1, 0.4

<UpperBoxLayout>:
    orientation: "horizontal"
    spacing: "12dp"
    padding: "12dp", "8dp", "12dp", "8dp"
    canvas.before:
        Color:
            rgba: (.45, .75, 1, 1)
        Rectangle:
            size: self.size
            pos: self.pos
        # Subtle shadow effect
        Color:
            rgba: (0, 0, 0, 0.1)
        Rectangle:
            pos: self.x, self.y - 2
            size: self.width, 2
    Button:
        text: ""
        background_color: 0, 0, 0, 0
        size_hint: None, 1
        width: "48dp"
        on_press: root.parent.parent.manager.current = "menu"
        canvas.before:
            Color:
                rgba: (1, 1, 1, 0.15) if self.state == "normal" else (1, 1, 1, 0.25)
            RoundedRectangle:
                size: self.size
                pos: self.pos
                radius: [8]
        canvas.after:
            Color:
                rgba: (1, 1, 1, 0.9) if self.state == "normal" else (1, 1, 1, 1)
            # Top line
            Rectangle:
                pos: self.x + self.width * 0.25, self.center_y + 10
                size: self.width * 0.5, 4
            # Middle line
            Rectangle:
                pos: self.x + self.width * 0.25, self.center_y
                size: self.width * 0.5, 4
            # Bottom line
            Rectangle:
                pos: self.x + self.width * 0.25, self.center_y - 10
                size: self.width * 0.5, 4
    Label:
        text: "Sudoku Puzzle"
        font_size: "22sp"
        bold: True
        color: (1, 1, 1, 1)
        size_hint: 1, 1
        halign: "left"
        valign: "center"
        text_size: self.size
        padding: "8dp", "0dp"

<Cell>:
    background_color: 0, 0, 0, 0
    background_normal: ""
    bold: "True"
    group: "Cells"
    font_size: self.size[0] * .8
    on_state: app.root.current_screen.children[0].on_cell_click(self, self.state)
    canvas.before:
        Color:
            rgba: (1, 1, 1, 1) if self.state == "normal" else (.5, .8, 1, 1)
        Rectangle:
            size: self.size
            pos: self.pos

<NumPadButton>:
    background_color: 0, 0, 0, 0
    background_normal: ''
    bold: True
    font_size: min(self.width, self.height) * 0.5
    color: (0.3, 0.3, 0.3, 1)
    canvas.before:
        Color:
            rgba: (1, 1, 1, 1) if self.state == "normal" else (.5, .8, 1, 1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [8]
        Color:
            rgba: (0.85, 0.85, 0.85, 1) if self.state == "normal" else (.4, .7, .95, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
            width: 1.5

<NumPadControlButton>:
    background_color: 0, 0, 0, 0
    background_normal: ''
    bold: True
    font_size: "18sp"
    color: (1, 1, 1, 1)
    canvas.before:
        Color:
            rgba: (0.9, 0.4, 0.4, 1) if self.state == "normal" else (0.95, 0.5, 0.5, 1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [8]

<NumPadLayout>:
    orientation: "vertical"
    spacing: "8dp"
    padding: "10dp"
    GridLayout:
        id: numbers_grid
        cols: 3
        rows: 3
        spacing: "6dp"
        size_hint: 1, 1
        padding: 0
        NumPadButton:
            text: "1"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "2"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "3"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "4"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "5"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "6"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "7"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "8"
            on_press: root.parent.parent.on_number_click(self)
        NumPadButton:
            text: "9"
            on_press: root.parent.parent.on_number_click(self)
    BoxLayout:
        orientation: "horizontal"
        spacing: "8dp"
        size_hint: 1, None
        height: "50dp"
        NumPadControlButton:
            text: "Delete"
            on_press: root.parent.parent.on_delete_click(self)
        NumPadControlButton:
            text: "Clear"
            on_press: root.parent.parent.on_clear_click(self)

<SudokuBox>:
    rows: 3
    spacing: "2dp"
    canvas.before:
        Color:
            rgba: (0.7, 0.7, 0.7, 1)
        Rectangle:
            size: self.size
            pos: self.pos

<SudokuGrid>:
    rows: 3
    padding: "4dp"
    spacing: "4dp"
    canvas.before:
        Color:
            rgba: (0, 0, 0, 1)
        Rectangle:
            size: self.size
            pos: self.pos

<SudokuGridLayout>:
    padding: "10dp"
    BoxLayout:
        size_hint: None, None
        size: min(root.width - 20, root.height - 20), min(root.width - 20, root.height - 20)
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        SudokuGrid:
            size_hint: 1, 1