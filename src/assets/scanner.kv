
<ScannerWidget>:
    canvas.before:
        Color:
            rgba: (0, 0, 0, 1)  # Black background for camera
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0

        # Header bar (consistent with other screens)
        BoxLayout:
            size_hint_y: None
            height: "64dp"
            orientation: "horizontal"
            spacing: "12dp"
            padding: "12dp", "8dp", "12dp", "8dp"
            canvas.before:
                Color:
                    rgba: (.45, .75, 1, 1)
                Rectangle:
                    size: self.size
                    pos: self.pos
                # Shadow effect
                Color:
                    rgba: (0, 0, 0, 0.1)
                Rectangle:
                    pos: self.x, self.y - 2
                    size: self.width, 2

            Button:
                text: "←"
                font_size: "24sp"
                background_color: 0, 0, 0, 0
                size_hint: None, 1
                width: "48dp"
                on_press: root.manager.current = "menu"
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 0.15) if self.state == "normal" else (1, 1, 1, 0.25)
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [8]

            Label:
                text: "Scan Puzzle"
                font_size: "22sp"
                bold: True
                color: (1, 1, 1, 1)
                size_hint: 1, 1
                halign: "left"
                valign: "center"
                text_size: self.size
                padding: "8dp", "0dp"

        # Camera preview and controls
        BoxLayout:
            orientation: "vertical"
            padding: "20dp"
            spacing: "16dp"

            # Camera view with overlay guide
            RelativeLayout:
                size_hint: 1, 0.65

                # Camera widget
                Camera:
                    id: camera
                    resolution: (640, 480)
                    play: False
                    allow_stretch: True
                    keep_ratio: True

                # Overlay guide (helps user frame puzzle)
                Widget:
                    canvas.after:
                        Color:
                            rgba: (1, 1, 1, 0.5)
                        Line:
                            rectangle: (self.x + self.width * 0.1, self.y + self.height * 0.15, self.width * 0.8, self.height * 0.7)
                            width: 2
                            dash_offset: 5
                            dash_length: 10
                        # Corner markers for better visibility
                        Line:
                            points: [self.x + self.width * 0.1, self.y + self.height * 0.85, self.x + self.width * 0.1 + 20, self.y + self.height * 0.85, self.x + self.width * 0.1, self.y + self.height * 0.85, self.x + self.width * 0.1, self.y + self.height * 0.85 - 20]
                            width: 3
                        Line:
                            points: [self.x + self.width * 0.9, self.y + self.height * 0.85, self.x + self.width * 0.9 - 20, self.y + self.height * 0.85, self.x + self.width * 0.9, self.y + self.height * 0.85, self.x + self.width * 0.9, self.y + self.height * 0.85 - 20]
                            width: 3
                        Line:
                            points: [self.x + self.width * 0.1, self.y + self.height * 0.15, self.x + self.width * 0.1 + 20, self.y + self.height * 0.15, self.x + self.width * 0.1, self.y + self.height * 0.15, self.x + self.width * 0.1, self.y + self.height * 0.15 + 20]
                            width: 3
                        Line:
                            points: [self.x + self.width * 0.9, self.y + self.height * 0.15, self.x + self.width * 0.9 - 20, self.y + self.height * 0.15, self.x + self.width * 0.9, self.y + self.height * 0.15, self.x + self.width * 0.9, self.y + self.height * 0.15 + 20]
                            width: 3

            # Status and controls area
            BoxLayout:
                orientation: "vertical"
                size_hint: 1, 0.35
                spacing: "12dp"
                padding: "20dp", "10dp"

                # Status label (shows feedback to user)
                Label:
                    id: status_label
                    text: "Position puzzle in frame"
                    font_size: "16sp"
                    color: (1, 1, 1, 1)
                    size_hint: 1, None
                    height: "60dp"
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                # Capture button
                Button:
                    id: capture_btn
                    text: "Capture & Scan"
                    font_size: "20sp"
                    bold: True
                    size_hint: 1, None
                    height: "60dp"
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: (1, 1, 1, 1)
                    on_press: root.capture_image()
                    canvas.before:
                        Color:
                            rgba: (0.2, 0.6, 0.9, 1) if self.state == "normal" and not self.disabled else (0.5, 0.5, 0.5, 1)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [12]

                # Back button
                Button:
                    text: "Back to Menu"
                    font_size: "16sp"
                    size_hint: 1, None
                    height: "48dp"
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    color: (0.8, 0.8, 0.8, 1)
                    on_press: root.manager.current = "menu"
                    canvas.before:
                        Color:
                            rgba: (0.3, 0.3, 0.3, 1)
                        RoundedRectangle:
                            size: self.size
                            pos: self.pos
                            radius: [8]
